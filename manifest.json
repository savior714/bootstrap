{
  "version": "1.3.0",
  "template_root": "templates",
  "description": "EMR agent governance + verification kernel export manifest (bootstrap SSOT)",
  "preserve_templates": [
    "Justfile.snippet",
    "docs/design.md",
    "docs/agent-context/memory/MEMORY.md",
    "docs/agent-context/memory/changelog/README.md",
    "docs/agent-context/memory/PROJECT_REFACTORING_BACKLOG.md"
  ],
  "entries": [
    {
      "src": "scripts/bootstrap/scaffold/AGENTS.md",
      "dest": "AGENTS.md"
    },
    {
      "src": "scripts/bootstrap/scaffold/PROJECT_RULES.md",
      "dest": "PROJECT_RULES.md"
    },
    {
      "src": "scripts/bootstrap/scaffold/CLAUDE.md",
      "dest": "CLAUDE.md"
    },
    {
      "src": "scripts/bootstrap/scaffold/copilot-instructions.md",
      "dest": "copilot-instructions.md"
    },
    {
      "src": "scripts/bootstrap/scaffold/Justfile.snippet",
      "dest": "Justfile.snippet"
    },
    { "src": "verify.sh", "dest": "verify.sh" },
    { "src": "tools/tdd_gate_plugin.py", "dest": "tools/tdd_gate_plugin.py" },
    { "src": "scripts/bootstrap/scaffold/tools/__init__.py", "dest": "tools/__init__.py" },
    { "src": "scripts/bootstrap/scaffold/pytest.ini", "dest": "pytest.ini" },
    { "src": "scripts/bootstrap/scaffold/tests/conftest.py", "dest": "tests/conftest.py" },
    {
      "src": "scripts/bootstrap/scaffold/docs/agent-context/memory/MEMORY.md",
      "dest": "docs/agent-context/memory/MEMORY.md"
    },
    {
      "src": "scripts/bootstrap/scaffold/docs/agent-context/memory/changelog/README.md",
      "dest": "docs/agent-context/memory/changelog/README.md"
    },
    {
      "src": "scripts/bootstrap/scaffold/docs/agent-context/memory/PROJECT_REFACTORING_BACKLOG.md",
      "dest": "docs/agent-context/memory/PROJECT_REFACTORING_BACKLOG.md"
    },
    {
      "src": "scripts/bootstrap/scaffold/docs/design.md",
      "dest": "docs/design.md"
    },
    {
      "src": "scripts/verify",
      "dest": "scripts/verify",
      "type": "dir",
      "exclude": [
        "fhir_4layer_verify.py",
        "renderer_route_smoke.sh",
        "check_renderer_deployment_profiles.py",
        "kcd_search_explain.py",
        "smoke_dashboard_rest.sh",
        "frontend.sh",
        "frontend_biome_gate.sh",
        "frontend_boundary_baseline.txt",
        "frontend_boundary_gate.py",
        "frontend_complexity_baseline.txt",
        "frontend_complexity_gate.py",
        "frontend_function_length_baseline.txt",
        "frontend_function_length_gate.py",
        "frontend_typecheck_gate.sh",
        "backend.sh",
        "backend_boundary_baseline.txt",
        "backend_boundary_gate.py",
        "backend_function_length_baseline.txt",
        "backend_function_length_gate.py",
        "db_schema_doctor.py",
        "form_catalog_search_verify.py"
      ]
    },
    {
      "src": "scripts/plan_loop",
      "dest": "scripts/plan_loop",
      "type": "dir"
    },
    {
      "src": "scripts/archive_plans.py",
      "dest": "scripts/archive_plans.py"
    },
    {
      "src": "scripts/archive_plans_cli.py",
      "dest": "scripts/archive_plans_cli.py"
    },
    {
      "src": "scripts/plan_archive_classify.py",
      "dest": "scripts/plan_archive_classify.py"
    },
    {
      "src": "scripts/plan_archive",
      "dest": "scripts/plan_archive",
      "type": "dir"
    },
    {
      "src": "scripts/agent",
      "dest": "scripts/agent",
      "type": "dir"
    },
    {
      "src": "docs/templates/TEMPLATE_blueprint.md",
      "dest": "docs/templates/TEMPLATE_blueprint.md"
    },
    {
      "src": "scripts/bootstrap/scaffold/agents/core",
      "dest": "agents/core",
      "type": "dir"
    },
    {
      "src": "scripts/bootstrap/scaffold/agents/registry/LOAD_ORDER.md",
      "dest": "agents/registry/LOAD_ORDER.md"
    },
    {
      "src": "scripts/bootstrap/scaffold/agents/registry/CONTEXT_ROUTING.md",
      "dest": "agents/registry/CONTEXT_ROUTING.md"
    },
    {
      "src": "scripts/bootstrap/scaffold/agents/registry/RULE_INDEX.md",
      "dest": "agents/registry/RULE_INDEX.md"
    },
    {
      "src": "scripts/bootstrap/scaffold/agents/registry/WORKFLOW_AND_SKILL_INDEX.md",
      "dest": "agents/registry/WORKFLOW_AND_SKILL_INDEX.md"
    },
    { "src": "agents/workflows/archive.md", "dest": "agents/workflows/archive.md" },
    { "src": "agents/workflows/diagnose.md", "dest": "agents/workflows/diagnose.md" },
    { "src": "agents/workflows/discover.md", "dest": "agents/workflows/discover.md" },
    { "src": "agents/workflows/discuss.md", "dest": "agents/workflows/discuss.md" },
    { "src": "agents/workflows/git.md", "dest": "agents/workflows/git.md" },
    { "src": "agents/workflows/go.md", "dest": "agents/workflows/go.md" },
    { "src": "agents/workflows/improve-codebase-architecture.md", "dest": "agents/workflows/improve-codebase-architecture.md" },
    { "src": "agents/workflows/investigate.md", "dest": "agents/workflows/investigate.md" },
    { "src": "agents/workflows/plan.md", "dest": "agents/workflows/plan.md" },
    { "src": "agents/workflows/playwright.md", "dest": "agents/workflows/playwright.md" },
    { "src": "agents/workflows/refactor.md", "dest": "agents/workflows/refactor.md" },
    { "src": "agents/workflows/review.md", "dest": "agents/workflows/review.md" },
    { "src": "agents/workflows/sync.md", "dest": "agents/workflows/sync.md" },
    { "src": "agents/domains/testing/playwright.md", "dest": "agents/domains/testing/playwright.md" },
    { "src": "agents/skills/diagnose", "dest": "agents/skills/diagnose", "type": "dir" },
    { "src": "agents/skills/discover", "dest": "agents/skills/discover", "type": "dir" },
    { "src": "agents/skills/discuss", "dest": "agents/skills/discuss", "type": "dir" },
    { "src": "agents/skills/improve-codebase-architecture", "dest": "agents/skills/improve-codebase-architecture", "type": "dir" },
    { "src": "agents/skills/investigate", "dest": "agents/skills/investigate", "type": "dir" },
    { "src": "agents/skills/plan", "dest": "agents/skills/plan", "type": "dir" },
    { "src": "agents/skills/refactor", "dest": "agents/skills/refactor", "type": "dir" },
    { "src": "agents/skills/review", "dest": "agents/skills/review", "type": "dir" },
    { "src": "agents/skills/sync", "dest": "agents/skills/sync", "type": "dir" }
  ],
  "replacements": [
    { "pattern": "Templar EMR", "replacement": "{{PROJECT_NAME}}" },
    { "pattern": "freeEMR", "replacement": "{{PROJECT_NAME}}" },
    { "pattern": "templaremr", "replacement": "{{LINEAR_WORKSPACE}}" },
    { "pattern": "apps/renderer", "replacement": "{{FRONTEND_APP_PATH}}" },
    { "pattern": "apps/desktop-tauri", "replacement": "{{DESKTOP_APP_PATH}}" },
    { "pattern": "@emr/", "replacement": "{{NPM_SCOPE}}/" },
    { "pattern": "http://127.0.0.1:3000", "replacement": "{{FRONTEND_DEV_URL}}" },
    { "pattern": "127.0.0.1:3000", "replacement": "{{FRONTEND_DEV_HOST}}" },
    { "pattern": ":8000", "replacement": ":{{BACKEND_PORT}}" }
  ],
  "secret_patterns": [
    "sk-[A-Za-z0-9]{20,}",
    "ghp_[A-Za-z0-9]{20,}",
    "lin_api_[A-Za-z0-9]{20,}",
    "AKIA[0-9A-Z]{16}"
  ]
}
